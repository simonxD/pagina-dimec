# @nuxt/content 3.15.2 declara better-sqlite3 ^12.5.0 como peer opcional, pero el
# proyecto usa ^13.0.3. npm aborta ante ese conflicto; bun lo toleraba, y por eso
# el proyecto se construyo con bun en su dia.
#
# La version 13 es la que corre en produccion sin incidencias. Se acepta aqui para
# que "npm install" funcione a secas, sin tener que recordar --legacy-peer-deps.
legacy-peer-deps=true
